# The one build environment for Veil: local builds (scripts/podman-run) and CI
# use this image, so a build does not depend on what the host has installed.
#
# Everything is pinned: the base image by digest, the Android command-line
# tools and rustup-init by SHA-256, SDK packages by version (sdkmanager checks
# their SHA-1 against Google's repository index), Rust by toolchain version and
# cargo tools by version with --locked. Changing this file changes the image
# tag scripts/podman-run uses, so the image is rebuilt only when it changes.
#
# Caches are not in the image. Cargo's registry, the cargo target directory and
# Gradle's caches are named volumes mounted at /cache by scripts/podman-run.

FROM docker.io/library/debian@sha256:4876fdea29cac1a33a3195f1eb1952feb1fca7dd6dd00be3e2f1879cf20d34d2

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip git \
      openjdk-21-jdk-headless \
      gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*

# Android SDK: command-line tools 23.0, then the exact packages the build uses.
ENV ANDROID_HOME=/opt/android-sdk
ARG CMDLINE_TOOLS_ZIP=commandlinetools-linux-16111833_latest.zip
ARG CMDLINE_TOOLS_SHA256=0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8
RUN curl -fsSLo /tmp/clt.zip https://dl.google.com/android/repository/${CMDLINE_TOOLS_ZIP} \
 && echo "${CMDLINE_TOOLS_SHA256}  /tmp/clt.zip" | sha256sum -c - \
 && mkdir -p ${ANDROID_HOME}/cmdline-tools \
 && unzip -q /tmp/clt.zip -d ${ANDROID_HOME}/cmdline-tools \
 && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
 && rm /tmp/clt.zip
ENV PATH=${ANDROID_HOME}/cmdline-tools/latest/bin:${PATH}
ARG NDK_VERSION=30.0.16248370
RUN yes | sdkmanager --licenses > /dev/null \
 && sdkmanager --install \
      "platforms;android-37.0" \
      "build-tools;36.0.0" \
      "ndk;${NDK_VERSION}" \
 && rm -rf /root/.android \
 # sdkmanager unpacks with mode 744; builds run as the invoking user, not root.
 && chmod -R a+rX ${ANDROID_HOME}
ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/${NDK_VERSION}
ENV PATH=${ANDROID_HOME}/build-tools/36.0.0:${PATH}

# Rust. The toolchain version matches rust-toolchain.toml.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ARG RUSTUP_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
ARG RUST_TOOLCHAIN=1.99.1
RUN curl -fsSLo /tmp/rustup-init https://static.rust-lang.org/rustup/archive/1.29.2/x86_64-unknown-linux-gnu/rustup-init \
 && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain ${RUST_TOOLCHAIN} \
      --component clippy --component rustfmt \
      --target aarch64-linux-android --target x86_64-linux-android \
 && rm /tmp/rustup-init
ENV PATH=/opt/cargo/bin:${PATH}
RUN cargo install --locked --root /opt/cargo cargo-ndk@4.1.2 cargo-deny@0.20.2 \
 && rm -rf /opt/cargo/registry /opt/cargo/git

# At run time the registry lives in a cache volume, not in the image.
ENV CARGO_HOME=/cache/cargo \
    CARGO_TARGET_DIR=/cache/target \
    GRADLE_USER_HOME=/cache/gradle \
    ANDROID_USER_HOME=/cache/android \
    RUSTUP_TOOLCHAIN=${RUST_TOOLCHAIN}
# The rustup proxies are in /opt/cargo/bin; with CARGO_HOME moved they still
# find the toolchain through RUSTUP_HOME.
WORKDIR /src
