<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Network access for SSH. In the long-term design only the Network Broker
      package holds this permission; until then the engine dials from here.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keeps the process alive while sessions are open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Strong biometric authorization for SSH signing keys. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Signature-level: the main app may bind the VM host's narrow service. -->
    <uses-permission android:name="io.github.franticplant.veil.permission.VM_HOST" />

    <queries>
        <package android:name="io.github.franticplant.veil.vm" />
    </queries>

    <!--
      allowBackup off: host keys, profiles and later credential handles must not
      leave the device through Android backup.

      AVF permissions belong to the separate <base>.vm package (MANAGE_VIRTUAL_MACHINE,
      USE_CUSTOM_VIRTUAL_MACHINE), not here. This package only binds its narrow
      service; keeping VM administration out of the UI/network UID is the point.
    -->
    <application
        android:name=".VeilApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps interactive SSH sessions open while the app is in the background" />
        </service>
    </application>
</manifest>
