#!/usr/bin/env bash
# Builds unsigned Veil APKs in the build container.
#
#   scripts/build [dev|prod|devd|all] [-- extra gradle args]
#
# Output: android/app/build/outputs/apk/<flavor>/release/app-<flavor>-release-unsigned.apk,
# and for devd (the dev agent package) android/devd/build/outputs/apk/release/devd-release-unsigned.apk
# Then: scripts/sign dev   (signs into dist/)
#
# The version comes from git, here on the host: versionCode is the commit time
# in minutes since the epoch times 10, so it never goes backwards and a dev and
# a prod build of one commit share it; versionName is <base>-g<sha>, plus
# "-dirty" when the tree has uncommitted changes.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
flavor=${1:-dev}
shift || true
[[ ${1:-} == -- ]] && shift

case $flavor in
dev) tasks=(:app:assembleDevRelease) ;;
prod) tasks=(:app:assembleProdRelease) ;;
devd) tasks=(:devd:assembleRelease) ;;
all) tasks=(:app:assembleDevRelease :app:assembleProdRelease :devd:assembleRelease) ;;
*) echo "usage: $0 [dev|prod|devd|all] [-- gradle args]" >&2; exit 2 ;;
esac

base=0.0.1
commit_time=$(git -C "$repo" log -1 --format=%ct)
sha=$(git -C "$repo" rev-parse --short=7 HEAD)
dirty=$(git -C "$repo" diff --quiet HEAD -- && echo || echo -dirty)
export VEIL_VERSION_CODE=$((commit_time / 60 * 10))
export VEIL_VERSION_NAME=$base-g$sha$dirty
# A release (VEIL_RELEASE_TAG=v1.2.3, set by release.yml) is named after its
# tag, and only builds from a clean tree at exactly that tag's commit.
if [[ -n ${VEIL_RELEASE_TAG:-} ]]; then
	[[ $VEIL_RELEASE_TAG =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] ||
		{ echo "release tag $VEIL_RELEASE_TAG is not vMAJOR.MINOR.PATCH[-suffix]" >&2; exit 1; }
	[[ -z $dirty ]] || { echo "refusing a release build from a dirty tree" >&2; exit 1; }
	[[ $(git -C "$repo" rev-parse "refs/tags/$VEIL_RELEASE_TAG^{commit}") == $(git -C "$repo" rev-parse HEAD) ]] ||
		{ echo "HEAD is not the commit of $VEIL_RELEASE_TAG" >&2; exit 1; }
	export VEIL_VERSION_NAME=${VEIL_RELEASE_TAG#v}
fi
echo "versionCode $VEIL_VERSION_CODE, versionName $VEIL_VERSION_NAME" >&2

exec "$repo/scripts/podman-run" ./android/gradlew -p android --console=plain "${tasks[@]}" "$@"
