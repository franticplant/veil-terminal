#!/usr/bin/env bash
# Signs a built APK with the Veil key.
#
#   scripts/sign dev|prod|devd|vm
#       Signs android/app/build/outputs/apk/<flavor>/release/...-unsigned.apk
#       (devd: android/devd/build/outputs/apk/release/devd-release-unsigned.apk;
#        vm: android/vm/build/outputs/apk/release/vm-release-unsigned.apk) in
#       a network-less container (in CI, with VEIL_HOST_TOOLCHAIN=1, on the runner). Needs VEIL_KEYSTORE (path to the PKCS12
#       keystore, alias "veil") and VEIL_KEYSTORE_PASSWORD in the environment;
#       CI sets both from the "release" environment's secrets.
#
#   scripts/sign --finish dev|prod|devd|vm DIR [VIA]
#       For signing set-ups outside this repo: DIR holds the output of
#       scripts/lib/sign-apk.sh (signed.apk, .idsig, .certs, .badging); this
#       does the remaining steps. VIA is recorded in the log.
#
# Then: checks the signer against the pinned digest in
# dev/signing/veil-release-cert.sha256, writes dist/veil-<versionName>.apk
# (devd: dist/veil-devd-<versionName>.apk, vm: dist/veil-vm-<versionName>.apk)
# (+ .idsig, the v4 signature that incremental installs and Microdroid use),
# appends a line to ~/.local/state/veil/signing.log, and runs
# scripts/check-release-apk.sh on Veil APKs.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)

usage() {
	echo "usage: $0 dev|prod|devd | --finish dev|prod|devd DIR [VIA]" >&2
	exit 2
}

finish() {
	local flavor=$1 dir=$2 via=$3
	local want got version out sha log check=()
	want=$(tr -d '[:space:]' < "$repo/dev/signing/veil-release-cert.sha256")
	got=$(sed -n 's/^Signer #1 certificate SHA-256 digest: //p' "$dir/signed.apk.certs")
	if [[ $got != "$want" ]]; then
		echo "signer digest $got does not match the pinned $want" >&2
		exit 1
	fi
	version=$(sed -n "s/.* versionName='\([^']*\)'.*/\1/p" "$dir/signed.apk.badging")
	mkdir -p "$repo/dist"
	if [[ $flavor == devd ]]; then
		out=$repo/dist/veil-devd-$version.apk
	elif [[ $flavor == vm ]]; then
		out=$repo/dist/veil-vm-$version.apk
	else
		out=$repo/dist/veil-$version.apk
	fi
	mv "$dir/signed.apk" "$out"
	mv "$dir/signed.apk.idsig" "$out.idsig"
	sha=$(sha256sum "$out" | cut -d' ' -f1)

	log=${XDG_STATE_HOME:-$HOME/.local/state}/veil/signing.log
	mkdir -p "$(dirname "$log")"
	printf '%s via=%s apk=%s sha256=%s signer=%s\n' \
		"$(date -Is)" "$via" "$(basename "$out")" "$sha" "$got" >> "$log"
	echo "signed $out ($via)"

	# devd and vm are not Veil: the Veil release check does not apply to them.
	[[ $flavor == devd || $flavor == vm ]] && return 0
	[[ $flavor == dev ]] && check=(--expect-dev)
	"$repo/scripts/run" --offline scripts/check-release-apk.sh "${check[@]}" "dist/$(basename "$out")"
}

if [[ ${1:-} == --finish ]]; then
	[[ $# -ge 3 ]] || usage
	[[ $2 == dev || $2 == prod || $2 == devd || $2 == vm ]] || usage
	finish "$2" "$3" "${4:-external}"
	exit 0
fi

flavor=${1:-}
[[ $flavor == dev || $flavor == prod || $flavor == devd || $flavor == vm ]] || usage

unsigned=$repo/android/app/build/outputs/apk/$flavor/release/app-$flavor-release-unsigned.apk
[[ $flavor == devd ]] && unsigned=$repo/android/devd/build/outputs/apk/release/devd-release-unsigned.apk
[[ $flavor == vm ]] && unsigned=$repo/android/vm/build/outputs/apk/release/vm-release-unsigned.apk
[[ -f $unsigned ]] || { echo "no unsigned APK at $unsigned; run scripts/build $flavor first" >&2; exit 1; }
: "${VEIL_KEYSTORE:?set VEIL_KEYSTORE to the keystore path}"
: "${VEIL_KEYSTORE_PASSWORD:?set VEIL_KEYSTORE_PASSWORD}"
[[ -f $VEIL_KEYSTORE ]] || { echo "keystore not found: $VEIL_KEYSTORE" >&2; exit 1; }
export VEIL_KEYSTORE_PASSWORD

mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
work=$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/veil-sign.XXXXXX")
trap 'rm -rf "$work"' EXIT
cp "$unsigned" "$work/in.apk"

if [[ ${VEIL_HOST_TOOLCHAIN:-} == 1 ]]; then
	# CI: the runner has the pinned build tools, and this job is the only one
	# that holds the key (the "release" environment).
	VEIL_KEYSTORE_PATH=$VEIL_KEYSTORE "$repo/scripts/lib/sign-apk.sh" "$work/in.apk" "$work/signed.apk"
else
	image=$("$repo/scripts/lib/image-tag.sh" "$repo")
	podman image exists "$image" || { echo "build image $image missing; run scripts/build first" >&2; exit 1; }
	# label=disable: the keystore is bind-mounted read-only without relabeling it.
	podman run --rm --network=none --security-opt label=disable --userns=keep-id \
		-v "$repo/scripts/lib":/src/scripts/lib:ro \
		-v "$work":/work \
		-v "$VEIL_KEYSTORE":/signing/veil-release.p12:ro \
		-e VEIL_KEYSTORE_PASSWORD \
		"$image" /src/scripts/lib/sign-apk.sh /work/in.apk /work/signed.apk
fi

finish "$flavor" "$work" direct
